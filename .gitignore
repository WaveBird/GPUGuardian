*.swiftdoc
*.dSYM/
DerivedData/

# Bundled app product (rebuild with ./build.sh)
*.app/

# Xcode / SwiftPM
*.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.swiftpm/

# Logs & temporary files
*.log
*.tmp
*.swp
*~

# Local environment overrides
.env
.env.local
